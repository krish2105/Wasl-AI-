#!/usr/bin/env python3
"""MCP server for $site_name, generated by Wasl AI.

GENERATED FILE — do not edit by hand. Regenerate from the Wasl report instead.

$site_name was scanned on $generated_at and scored $score on the Wasl
Agent-Readiness Index. The tools below were induced from evidence found in that
site's public markup, and every one of them cites the evidence that justified it
(see EVIDENCE below each tool).

## What this server does and does not do

- **Read-only.** Every tool is a search or a lookup. Nothing books, buys,
  submits or changes anything. Wasl does not generate state-changing tools for
  sites it does not control.
- **Reads from a cached snapshot by default.** The crawl that produced this
  server is stored alongside it. Running this server sends no traffic to
  $domain unless you pass --live.
- **Unofficial.** $site_name did not publish this and has not endorsed it. It is
  a demonstration of what an agent-readable interface to their public content
  could look like.

## Install

    pip install "mcp[cli]"
    python server.py

## Claude Desktop

    {
      "mcpServers": {
        "$server_name": {
          "command": "python",
          "args": ["$abs_path_placeholder/server.py"]
        }
      }
    }
"""

# NOTE: deliberately no `from __future__ import annotations`.
#
# FastMCP builds a Pydantic arguments model from each tool's signature at
# registration time. With PEP 563 the annotations are strings, and the enum used
# for response_format is not resolvable in the namespace FastMCP rebuilds in —
# the server imports fine by eye and then fails when a client lists tools.
#
# Found by the verification subprocess, which is the entire reason it exists.

import argparse
import json
from enum import Enum
from pathlib import Path
from typing import Any, Optional

from mcp.server.fastmcp import FastMCP
from pydantic import BaseModel, ConfigDict, Field

# --- constants ---------------------------------------------------------------

SITE_NAME = "$site_name"
SITE_DOMAIN = "$domain"
SNAPSHOT_PATH = Path(__file__).parent / "snapshot.json"

mcp = FastMCP("$server_name")


class ResponseFormat(str, Enum):
    """Output format for tool responses."""

    MARKDOWN = "markdown"
    JSON = "json"


# --- shared helpers ----------------------------------------------------------


def _load_snapshot() -> dict[str, Any]:
    """Read the cached crawl this server was generated from.

    Returning an empty snapshot rather than raising keeps the server importable
    and its tools introspectable even when the data file is missing, which is
    what the MCP client needs in order to list tools at all.
    """
    if not SNAPSHOT_PATH.exists():
        return {"pages": [], "records": []}
    try:
        return json.loads(SNAPSHOT_PATH.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return {"pages": [], "records": [], "error": f"snapshot unreadable: {exc}"}


def _records() -> list[dict[str, Any]]:
    return _load_snapshot().get("records", [])


def _match(record: dict[str, Any], query: str) -> bool:
    """Case-insensitive substring match across a record's text fields."""
    if not query:
        return True
    haystack = " ".join(str(v) for v in record.values() if isinstance(v, (str, int, float)))
    return query.lower() in haystack.lower()


def _paginate(items: list[Any], limit: int, offset: int) -> dict[str, Any]:
    """Standard pagination envelope, per MCP best practice."""
    window = items[offset : offset + limit]
    return {
        "total": len(items),
        "count": len(window),
        "offset": offset,
        "items": window,
        "has_more": offset + len(window) < len(items),
        "next_offset": offset + len(window) if offset + len(window) < len(items) else None,
    }


def _format(payload: dict[str, Any], fmt: ResponseFormat, title: str) -> str:
    """Render a payload as JSON or human-readable markdown."""
    if fmt is ResponseFormat.JSON:
        return json.dumps(payload, indent=2, ensure_ascii=False)

    lines = [f"# {title}", ""]
    if "items" in payload:
        lines.append(f"Found {payload['total']} result(s), showing {payload['count']}.")
        lines.append("")
        for item in payload["items"]:
            name = item.get("name") or item.get("title") or item.get("id") or "(untitled)"
            lines.append(f"## {name}")
            for key, value in item.items():
                if key in {"name", "title"} or value in (None, "", []):
                    continue
                lines.append(f"- **{key}**: {value}")
            lines.append("")
        if payload.get("has_more"):
            lines.append(f"_More available — call again with offset={payload['next_offset']}._")
    else:
        for key, value in payload.items():
            lines.append(f"- **{key}**: {value}")
    return "\n".join(lines)


def _no_results(query: str) -> str:
    """Actionable empty result, per MCP error-message guidance."""
    return (
        f"No results matching '{query}' in the cached snapshot of {SITE_DOMAIN}. "
        f"The snapshot holds {len(_records())} record(s) — try a broader query, or "
        f"regenerate the snapshot if the site has changed."
    )


# --- tools -------------------------------------------------------------------

$tools

# --- entrypoint --------------------------------------------------------------

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=f"MCP server for {SITE_NAME}")
    parser.add_argument(
        "--live",
        action="store_true",
        help=(
            "Opt in to fetching from the live site instead of the cached snapshot. "
            "Not implemented in generated servers: doing so would send traffic to a "
            "third party who did not ask for it."
        ),
    )
    args = parser.parse_args()

    if args.live:
        raise SystemExit(
            "--live is deliberately not implemented. This server reads a cached "
            f"snapshot so that running it sends no requests to {SITE_DOMAIN}."
        )

    mcp.run()
